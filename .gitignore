# Rust
/target
**/*.rs.bk

# Xcode (the project file is generated by XcodeGen from apps/Klinote/project.yml)
apps/Klinote/*.xcodeproj/
apps/Klinote/*.xcworkspace/
apps/Klinote/DerivedData/

# Local data — never commit encounter data, transcripts, notes or audio
*.wav
*.m4a
*.caf
*.mp3
*.db
*.db-shm
*.db-wal
/data/
/fixtures/private/
/fixtures/note-bench/last-report.json
/fixtures/note-bench/last-note.json
/fixtures/note-bench/last-fail.txt
scripts/__pycache__/

# macOS
.DS_Store

# Swift shell (added later)
/apps/LocalClinicalScribe/build/
/apps/LocalClinicalScribe/DerivedData/
*.xcuserstate
xcuserdata/

# Build output and packaged releases
/build/
/dist/

# Agent/tool state
.commandcode/

# Go-to-market collateral (sales playbook, personas, battle cards, competitor
# research). Deliberately not in the public repository — the same boundary as
# the earlier go-to-market removal. It lives on this machine, not on GitHub.
docs/marketing/collateral/

# Python caches anywhere, not only under scripts/
__pycache__/
*.pyc

# Local model weights
*.gguf

# Local Netlify folder
.netlify
