<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Sandboxed.

	  The reason is containment, not compliance. Klinote takes input from three
	  places it does not control — a microphone, an audio file, and a GGUF model
	  downloaded over the network — and reads the last of them with a large C++
	  parser, llama.cpp in the `scribe-llm` helper. The sandbox is what limits
	  what a memory-safety bug there can reach. For an app holding clinical
	  records that is worth having even though the Mac App Store, the only place
	  it is mandatory, is not where this ships.

	  There used to be two such parsers. Audio went through whisper.cpp as well;
	  speech recognition is now the system's own SpeechAnalyzer, so the audio
	  path no longer touches a third-party parser at all.

	  What it changes:
	    · the database, the models and the learned terms live in
	      ~/Library/Containers/one.klinote.mac/Data/Library/Application Support/Klinote
	      rather than ~/Library/Application Support/Klinote;
	    · a sandboxed build cannot read the old location — that is the point of
	      it — so an install from 0.1.x has to be moved once from outside the
	      app: scripts/move-into-container.sh;
	    · `device.audio-input` is the microphone, and is why the app asks.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!--
	  The note-model download is the only network use: downloads, never uploads.
	  It lives in exactly one file, which scripts/check-network-surface.sh
	  enforces. Speech recognition is not here — the system owns that asset.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
